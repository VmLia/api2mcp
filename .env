# ============================================
# API2MCP 配置文件
# 此文件同时用于前端和后端配置
# ============================================

# ─ 服务端口 ──
API2MCP_PORT_FRONTEND=34075
API2MCP_PORT_BACKEND=34085

# ── 前端配置（VITE_ 前缀的变量会暴露给浏览器端代码）──
# API 代理地址，留空则使用当前域名（生产环境推荐留空）
VITE_API_URL=

# ── 数据库配置 ─
DB_TYPE=postgresql
DB_HOST=192.100.34.10
DB_PORT=5432
DB_USER=agent
DB_PASSWORD=agent@123
DB_NAME=agent_platform
DB_DRIVER=asyncpg
# 完整数据库连接 URL（可选，留空则从上方分段参数自动拼接）
# 密码含特殊字符时建议用此方式直接指定，避免拼接问题
DATABASE_URL=

# ─ MCP 公开访问地址 ──
# 留空则自动使用 默认URL，会在API注册成功后显示在页面上
MCP_PUBLIC_BASE_URL=

