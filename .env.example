# ============================================
# API2MCP 配置文件示例
# ============================================
# 复制此文件为 .env 并填写实际配置值

# ── 服务端口 ──
API2MCP_HOST=0.0.0.0
API2MCP_PORT_FRONTEND=34075
API2MCP_PORT_BACKEND=34085

# ── 数据库初始化配置 ──
# API2MCP_DB_DEL: 是否在服务启动时删除已存在的表
# true  = 删除所有表并重新创建（数据全部清空）
# false = 仅创建缺失的表，保留已有数据（默认）
API2MCP_DB_DEL=false

# ── 前端配置（VITE_ 前缀的变量会暴露给浏览器端代码）──
# API 代理地址，留空则使用当前域名（生产环境推荐留空）
VITE_API_URL=

# ── MCP 公开访问地址 ──
# 留空则自动使用 http://127.0.0.1:{BACKEND_PORT}/mcpapi
# 生产环境部署时请设置为实际的公网地址，如 https://api.example.com
MCP_PUBLIC_BASE_URL=

# ── 数据库配置 ──
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=api2mcp
DB_PASSWORD=your_db_password
DB_NAME=api2mcp
DB_DRIVER=asyncpg
# 完整数据库连接 URL（可选，留空则从上方分段参数自动拼接）
# 密码含特殊字符时建议用此方式直接指定，避免拼接问题
DATABASE_URL=

# ── Redis 配置（用于状态管理、缓存、分布式锁）──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0
# Redis 是否可选（true=可选，服务启动不依赖Redis；false=必须，连接失败则服务启动失败）
REDIS_OPTIONAL=true
# Redis 连接超时（秒）
REDIS_SOCKET_TIMEOUT=5
REDIS_CONNECT_TIMEOUT=5

# ── LLM 配置（用于智能API解析）──
LLM_API_KEY=your_llm_api_key
LLM_API_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-v4-flash

# ── 默认用户配置 ──
DEFAULT_USER_ID=admin
DEFAULT_USER_NAME=admin

# ── HTTP 客户端配置 ──
# HTTP 客户端全局超时（秒）
HTTP_CLIENT_TIMEOUT=60
# 工具调用默认超时（毫秒）
TOOL_DEFAULT_TIMEOUT_MS=30000

# ── 日志配置 ──
LOG_LEVEL=INFO
# 是否启用请求日志（记录每个 API 请求的访问日志）
LOG_REQUEST_ENABLED=false
# 是否启用 uvicorn 访问日志（服务器级别的访问记录）
UVICORN_ACCESS_LOG=false

# ── 状态管理配置 ──
STATE_CACHE_TTL=3600
REQUEST_TIMEOUT=30

# ── Docker 配置 ──
# 是否构建并使用 Docker 镜像部署（true=使用镜像；false=源码本机部署）
API2MCP_IMAGE=false
# 镜像名称和标签
API2MCP_IMAGE_NAME=api2mcp
API2MCP_IMAGE_TAG=latest