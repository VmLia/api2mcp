# ============================================
# API2MCP 配置文件
# ============================================

# ── 服务端口 ──
API2MCP_PORT_FRONTEND=34075
API2MCP_PORT_BACKEND=34085

# ── 前端配置（VITE_ 前缀的变量会暴露给浏览器端代码）──
# API 代理地址，留空则使用当前域名（生产环境推荐留空）
VITE_API_URL=

# ── 数据库配置 ─
DB_TYPE=postgresql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=api2mcp
DB_PASSWORD=api2mcp@123
DB_NAME=api2mcp
DB_DRIVER=asyncpg
# 完整数据库连接 URL（可选，留空则从上方分段参数自动拼接）
# 密码含特殊字符时建议用此方式直接指定，避免拼接问题
DATABASE_URL=

# ── MCP 公开访问地址 ──
# 留空则自动使用 http://127.0.0.1:{BACKEND_PORT}/mcpapi
# 生产环境部署时请设置为实际的公网地址，如 https://api.example.com
MCP_PUBLIC_BASE_URL=

# ── 日志配置 ──
# 是否启用请求日志（记录每个 API 请求的访问日志）
# true - 启用日志（默认）
# false - 禁用日志
LOG_REQUEST_ENABLED=true

# 是否启用 uvicorn 访问日志（服务器级别的访问记录）
# true - 启用日志（默认）
# false - 禁用日志
UVICORN_ACCESS_LOG=true

# ── Docker 配置 ──镜像名称和标签
API2MCP_IMAGE_NAME=api2mcp
API2MCP_IMAGE_TAG=latest
